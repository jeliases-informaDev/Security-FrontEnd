# Con "npm run dev": copialo como ".env.local" (no se sube a git).
# Con "docker compose": copialo como ".env".

# URL del backend (incluye /api, sin barra al final). El backend escucha en el 8081 por defecto.
NEXT_PUBLIC_API_URL=http://localhost:8081/api

